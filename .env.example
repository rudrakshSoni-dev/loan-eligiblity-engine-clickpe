# Copy to .env and fill in. .env is gitignored; this file holds placeholders only.
# Deployed secrets live in SSM Parameter Store (SecureString) and are resolved
# by serverless.yml at deploy time; .env is only for local scripts and tests.

# AWS
AWS_PROFILE=clickpe
AWS_REGION=ap-southeast-2

# Groq (OpenAI-compatible API)
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# PostgreSQL (local docker for tests; RDS endpoint comes from SSM in AWS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loans
DB_USER=loans_app
DB_PASSWORD=<local-db-password>
# Path to the RDS CA bundle (global-bundle.pem); enables verified TLS. Leave empty for local docker.
DB_SSLROOTCERT=

# Lambda -> n8n webhook (shared secret sent as X-Webhook-Secret)
N8N_WEBHOOK_URL=http://<ec2-private-ip>:5678/webhook/match-batch
N8N_WEBHOOK_SECRET=<random-32-byte-hex>

# Email safety: every recipient must be one of these verified SES identities
TEST_INBOX_ALIASES=<you@example.com>,<you+one@example.com>,<you+two@example.com>
DRY_RUN=true
